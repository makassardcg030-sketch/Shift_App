<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pwidget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="@drawable/widget_bg">

    <!-- 1. Nama Personal -->
    <TextView
        android:id="@+id/pwidget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:gravity="center"
        android:text="Pilih Nama ▼"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:singleLine="true" />

    <!-- 2. Jadwal Sekarang -->
    <LinearLayout
        android:id="@+id/p_duty_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:gravity="center"
        android:background="#2563EB"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pwidget_duty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Off / Libur"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 3. Jadwal Akan Datang -->
    <LinearLayout
        android:id="@+id/p_next_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:gravity="center"
        android:background="#FACC15"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pwidget_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="-"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 4. Icon Alarm -->
    <Button
        android:id="@+id/pwidget_btn_alarm"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="3dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:gravity="center"
        android:text="⏰"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:background="#DC2626" />

</LinearLayout>