<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="6dp" android:background="#0F172A">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JADWAL SHIFT  •  " android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
        <TextClock android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:format12Hour="EEE, dd MMM" android:format24Hour="EEE, dd MMM" android:textColor="#FACC15" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jam  " android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold"/>
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:layout_margin="2dp" android:gravity="center" android:background="#1E293B" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp" android:text="SHIFT"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="2dp" android:gravity="center" android:background="#1E293B" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp" android:text="Nama"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_margin="2dp" android:gravity="center" android:background="#1E293B" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp" android:text="Jam"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="2dp" android:gravity="center" android:background="#1E293B" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp" android:text="Nama"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_margin="2dp" android:gravity="center" android:background="#1E293B" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp" android:text="Jam"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:layout_margin="2dp" android:gravity="center" android:background="#2563EB" android:textColor="#FFFFFF" android:textSize="12sp" android:text="Duty:"/>
        <TextView android:id="@+id/duty_name1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="2dp" android:gravity="center" android:singleLine="true" android:background="#2563EB" android:textColor="#FFFFFF" android:textSize="12sp" android:text="-"/>
        <TextView android:id="@+id/duty_time1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_margin="2dp" android:gravity="center" android:singleLine="true" android:background="#2563EB" android:textColor="#FFFFFF" android:textSize="12sp" android:text=""/>
        <TextView android:id="@+id/duty_name2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="2dp" android:gravity="center" android:singleLine="true" android:background="#2563EB" android:textColor="#FFFFFF" android:textSize="12sp" android:text=""/>
        <TextView android:id="@+id/duty_time2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_margin="2dp" android:gravity="center" android:singleLine="true" android:background="#2563EB" android:textColor="#FFFFFF" android:textSize="12sp" android:text=""/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:layout_margin="2dp" android:gravity="center" android:background="#FACC15" android:textColor="#0F172A" android:textSize="12sp" android:text="Next:"/>
        <TextView android:id="@+id/next_name1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="2dp" android:gravity="center" android:singleLine="true" android:background="#FACC15" android:textColor="#0F172A" android:textSize="12sp" android:text="-"/>
        <TextView android:id="@+id/next_time1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_margin="2dp" android:gravity="center" android:singleLine="true" android:background="#FACC15" android:textColor="#0F172A" android:textSize="12sp" android:text=""/>
        <TextView android:id="@+id/next_name2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="2dp" android:gravity="center" android:singleLine="true" android:background="#FACC15" android:textColor="#0F172A" android:textSize="12sp" android:text=""/>
        <TextView android:id="@+id/next_time2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_margin="2dp" android:gravity="center" android:singleLine="true" android:background="#FACC15" android:textColor="#0F172A" android:textSize="12sp" android:text=""/>
    </LinearLayout>
</LinearLayout>
