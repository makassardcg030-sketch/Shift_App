<?xml version="1.0" encoding="utf-8"?>
<!-- Tabel 4 baris: HARI INI/Time, header SHIFT (merah), Duty (biru), Next (kuning) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="1dp"
    android:background="@drawable/widget_bg">

    <!-- Baris 1: HARI INI 15-Nov     Time 17:29 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="1dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:background="#FFFFFF">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HARI INI  "
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextClock
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:format12Hour="dd-MMM"
            android:format24Hour="dd-MMM"
            android:textColor="#FF0000"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time  "
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FF0000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Baris 2: header merah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:layout_margin="1dp" android:gravity="center" android:background="#FF0000" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:text="SHIFT" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="1dp" android:gravity="center" android:background="#FF0000" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:text="Name" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_margin="1dp" android:gravity="center" android:background="#FF0000" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:text="Time" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="1dp" android:gravity="center" android:background="#FF0000" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:text="Name" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_margin="1dp" android:gravity="center" android:background="#FF0000" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:text="Time" />
    </LinearLayout>

    <!-- Baris 3: Duty (biru) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:layout_margin="1dp" android:gravity="center" android:background="#0070C0" android:textColor="#FFFFFF" android:textSize="12sp" android:text="Duty:" />
        <TextView android:id="@+id/duty_name1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="1dp" android:gravity="center" android:singleLine="true" android:background="#0070C0" android:textColor="#FFFFFF" android:textSize="12sp" android:text="-" />
        <TextView android:id="@+id/duty_time1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_margin="1dp" android:gravity="center" android:singleLine="true" android:background="#0070C0" android:textColor="#FFFFFF" android:textSize="12sp" android:text="" />
        <TextView android:id="@+id/duty_name2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="1dp" android:gravity="center" android:singleLine="true" android:background="#0070C0" android:textColor="#FFFFFF" android:textSize="12sp" android:text="" />
        <TextView android:id="@+id/duty_time2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_margin="1dp" android:gravity="center" android:singleLine="true" android:background="#0070C0" android:textColor="#FFFFFF" android:textSize="12sp" android:text="" />
    </LinearLayout>

    <!-- Baris 4: Next (kuning) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:layout_margin="1dp" android:gravity="center" android:background="#FFFF00" android:textColor="#000000" android:textSize="12sp" android:text="Next:" />
        <TextView android:id="@+id/next_name1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="1dp" android:gravity="center" android:singleLine="true" android:background="#FFFF00" android:textColor="#000000" android:textSize="12sp" android:text="-" />
        <TextView android:id="@+id/next_time1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_margin="1dp" android:gravity="center" android:singleLine="true" android:background="#FFFF00" android:textColor="#000000" android:textSize="12sp" android:text="" />
        <TextView android:id="@+id/next_name2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="1dp" android:gravity="center" android:singleLine="true" android:background="#FFFF00" android:textColor="#000000" android:textSize="12sp" android:text="" />
        <TextView android:id="@+id/next_time2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_margin="1dp" android:gravity="center" android:singleLine="true" android:background="#FFFF00" android:textColor="#000000" android:textSize="12sp" android:text="" />
    </LinearLayout>
</LinearLayout>
